# --- the festival window -------------------------------------------------
# The exact instant Bappa arrives. Ten days later, visarjan begins on its
# own -- for every visitor at once, since it is derived from this and not
# from any session. Set this to the real muhurat for the year you run.
NEXT_PUBLIC_BAPPA_START=2026-09-14T06:00:00+05:30

# Offerings needed to complete him. Lower it to a handful while you are
# building, or each submission moves the sculpture by a fraction of a
# percent and you will not see anything happen.
NEXT_PUBLIC_BAPPA_TARGET=1008

# --- the shared tally ----------------------------------------------------
# Provision a KV / Upstash Redis store and connect it to the project; the
# integration sets these for you. Without them the app still runs, but each
# visitor builds their own private Bappa instead of a shared one.
#
# Vercel KV sets:      KV_REST_API_URL / KV_REST_API_TOKEN
# Upstash direct sets: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Either pair works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- development ---------------------------------------------------------
# Enables the dev control panel in a production build (staging only).
# NEXT_PUBLIC_BAPPA_DEV=1
