# --- the festival window -------------------------------------------------
# The exact instant Bappa arrives. Ten days later, visarjan begins on its
# own -- for every visitor at once, since the SERVER derives it from this
# and never from a browser's clock.
#
# BAPPA_START is the one that decides anything. The NEXT_PUBLIC_ copy is
# only so the countdown can tick between snapshots; it is corrected
# against the server's time on every snapshot, so the two need not agree
# and a visitor cannot move the festival by changing their clock.
BAPPA_START=2026-09-14T06:00:00+05:30
NEXT_PUBLIC_BAPPA_START=2026-09-14T06:00:00+05:30

# Offerings that would complete him on their own, with no days passing.
# Lower it to a handful while you are building, or each submission moves
# the sculpture by a fraction of a percent and you will not see anything.
BAPPA_TARGET=1008
NEXT_PUBLIC_BAPPA_TARGET=1008

# --- the collective ------------------------------------------------------
# The one Bappa lives here: the offerings, the tally, and the realtime
# every browser watches him through.
#
# Run supabase/schema.sql once in the SQL editor, then set these. The
# service key is the ONLY thing allowed to write -- row-level security
# leaves the anon key able to read offerings and nothing else, which is
# what stops a browser announcing that the tally moved. Keep the service
# key server-side: never NEXT_PUBLIC_.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# The browser needs these two to hold its realtime socket. Public by
# design, and safe: RLS makes them read-only.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salts the hash that rate limiting buckets addresses by, so preventing
# abuse does not require keeping a record of who was here. Any long
# random string; changing it simply resets everyone's window.
# BAPPA_IP_SALT=

# Redis is still supported for a deploy that already had it, and is used
# only if Supabase is absent.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# WITH NEITHER, the server falls back to per-instance memory. That is fine
# for `next dev` -- it is a single process, so two browser windows really
# do share one Bappa and the whole collective experience can be developed
# and tested with no account anywhere. On a deploy it is NOT fine: every
# instance would get its own Bappa. The server warns loudly if it happens.

# --- development ---------------------------------------------------------
# Enables the dev control panel, and the route that stands the collective
# tally at a chosen number, in a production build. Staging only.
# NEXT_PUBLIC_BAPPA_DEV=1
# BAPPA_DEV=1
